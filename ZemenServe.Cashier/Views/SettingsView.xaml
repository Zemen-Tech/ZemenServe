<UserControl x:Class="ZemenServe.Cashier.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="👤 Waiter Registration &amp; Sales Performance" Foreground="White" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="Register waitstaff names, track order sales, and view top performing waiters." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Main Content Grid -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Column 1: Register New Waiter Card -->
            <Border Grid.Column="0" Background="{StaticResource CardBackgroundBrush}" CornerRadius="12" Padding="20" Margin="0,0,15,0" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Register New Waiter" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                    <TextBlock Text="Waiter Name:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding NewWaiterName, UpdateSourceTrigger=PropertyChanged}" 
                             Height="38" Padding="10,0" VerticalContentAlignment="Center"
                             Background="#1E1E2E" Foreground="White" BorderBrush="{StaticResource BorderColorBrush}" Margin="0,0,0,15"/>

                    <Button Content="+ Register Waiter" Style="{StaticResource PrimaryButtonStyle}" Height="40"
                            Command="{Binding AddWaiterCommand}"/>

                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AccentGreenBrush}" 
                               FontSize="12" Margin="0,15,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Column 2: Registered Waiters List -->
            <Border Grid.Column="1" Background="{StaticResource CardBackgroundBrush}" CornerRadius="12" Padding="20" Margin="0,0,15,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Active Waitstaff Roster" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Waiters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E1E2E" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="15" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Id, StringFormat='ID: #{0}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                            </StackPanel>

                                            <Button Grid.Column="1" Content="Remove" Style="{StaticResource DangerButtonStyle}" Height="32" Padding="10,0"
                                                    Command="{Binding DataContext.DeleteWaiterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Column 3: Sales Leaderboard ("Who Sold More?") -->
            <Border Grid.Column="2" Background="{StaticResource CardBackgroundBrush}" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="🏆 Top Sellers Leaderboard (Who Sold More?)" Foreground="White" FontSize="16" FontWeight="Bold"/>
                        <Button Content="🔄 Refresh" HorizontalAlignment="Right" Style="{StaticResource PrimaryButtonStyle}" Height="26" Padding="8,0"
                                Command="{Binding LoadWaitersCommand}"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding WaiterLeaderboard}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E1E2E" CornerRadius="8" Padding="14" Margin="0,0,0,10"
                                            BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Rank Badge -->
                                            <Border Grid.Column="0" CornerRadius="6" Padding="8,4" Background="#3A2A10" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Badge}" Foreground="{StaticResource AccentOrangeBrush}" FontSize="13" FontWeight="Bold"/>
                                            </Border>

                                            <!-- Name & Orders Count -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding WaiterName}" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding TotalOrders, StringFormat='Orders Handled: {0}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                            </StackPanel>

                                            <!-- Total Sales Revenue -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding TotalRevenue, StringFormat='{}{0:N2} ETB'}" Foreground="{StaticResource AccentGreenBrush}" FontSize="17" FontWeight="Bold"/>
                                                <TextBlock Text="Total Sales" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
