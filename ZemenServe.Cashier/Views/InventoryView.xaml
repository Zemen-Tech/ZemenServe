<UserControl x:Class="ZemenServe.Cashier.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Ingredient Inventory &amp; Stock Management" Foreground="White" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="Live stock control, search, duplicate name prevention, edit/delete, and low-stock alerts" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
        </StackPanel>

        <!-- Main Content TabControl -->
        <Grid Grid.Row="1">
            <TabControl Background="Transparent" BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="HeaderTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="15" FontWeight="Bold" Padding="12,8"/>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                        <Setter Property="Background" Value="#252538"/>
                        <Setter Property="Margin" Value="0,0,8,0"/>
                    </Style>
                </TabControl.Resources>

                <!-- Tab 1: Current Stock & Actions -->
                <TabItem Header="📦 Current Stock &amp; Restock / Register">
                    <Grid Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="380"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Search & Stock Table -->
                        <Grid Grid.Column="0" Margin="0,0,15,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Search Filter Bar -->
                            <Border Grid.Row="0" Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🔍 Search Ingredient:" Foreground="{StaticResource TextSecondaryBrush}" 
                                               FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding IngredientSearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                             Background="#1E1E2E" Foreground="White" BorderBrush="{StaticResource BorderColorBrush}" 
                                             Padding="8" FontSize="13"/>
                                </Grid>
                            </Border>

                            <!-- Stock DataGrid -->
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Ingredients}" SelectedItem="{Binding SelectedIngredient}"
                                      AutoGenerateColumns="False" IsReadOnly="True" Background="{StaticResource CardBackgroundBrush}"
                                      Foreground="White" RowBackground="#252538" AlternatingRowBackground="#2D2D44"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderColorBrush}"
                                      HeadersVisibility="Column" BorderThickness="0">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <!-- Highlight Low Stock Rows in Dark Red -->
                                            <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                <Setter Property="Background" Value="#3D1E24"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="45"/>
                                    <DataGridTextColumn Header="Ingredient Name" Binding="{Binding Name}" Width="*"/>

                                    <!-- Status Column with Warning Badge -->
                                    <DataGridTemplateColumn Header="Stock Status" Width="135">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#28A745"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                                    <Setter Property="Background" Value="#DC3545"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StockStatus}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Current Stock" Binding="{Binding StockQuantity, StringFormat='{}{0:F2}'}" Width="105"/>
                                    <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="65"/>
                                    <DataGridTextColumn Header="Low Threshold" Binding="{Binding LowStockThreshold, StringFormat='{}{0:F2}'}" Width="105"/>
                                    <DataGridTextColumn Header="Unit Cost (ETB)" Binding="{Binding CostPerUnit, StringFormat='{}{0:N2}'}" Width="110"/>

                                    <DataGridTemplateColumn Header="Actions" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Content="Edit" Style="{StaticResource PrimaryButtonStyle}" Padding="8,4" FontSize="11" Margin="0,0,4,0"
                                                            Command="{Binding DataContext.StartEditIngredientCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="Delete" Style="{StaticResource DangerButtonStyle}" Padding="8,4" FontSize="11"
                                                            Command="{Binding DataContext.DeleteIngredientCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <!-- Right Column: Actions (Restock & Add New) -->
                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Restock Existing Panel -->
                                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="10" Padding="15" Margin="0,0,0,15">
                                    <StackPanel>
                                        <TextBlock Text="Restock Selected Ingredient" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                                        <TextBlock Text="Selected Ingredient:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding SelectedIngredient.Name, FallbackValue='(Select ingredient from table)'}" 
                                                   Foreground="{StaticResource AccentGreenBrush}" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>

                                        <TextBlock Text="Quantity to Add:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding RestockQuantity, UpdateSourceTrigger=PropertyChanged}" 
                                                 Background="#1E1E2E" Foreground="White" BorderBrush="{StaticResource BorderColorBrush}" Padding="6" Margin="0,0,0,10"/>

                                        <TextBlock Text="Note / Reference (Who &amp; Why):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding RestockReason, UpdateSourceTrigger=PropertyChanged}" 
                                                 Background="#1E1E2E" Foreground="White" BorderBrush="{StaticResource BorderColorBrush}" Padding="6" Margin="0,0,0,12"/>

                                        <Button Content="+ APPLY RESTOCK" Style="{StaticResource SuccessButtonStyle}" Height="40"
                                                Command="{Binding RestockCommand}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Register New Ingredient Panel -->
                                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="10" Padding="15">
                                    <StackPanel>
                                        <TextBlock Text="Register Brand New Ingredient" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                                        <TextBlock Text="Ingredient Name:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" 
                                                 Background="#1E1E2E" Foreground="White" BorderBrush="{StaticResource BorderColorBrush}" Padding="6" Margin="0,0,0,8"/>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                                <TextBlock Text="Unit Metric:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,2"/>
                                                <ComboBox ItemsSource="{Binding UnitsList}" SelectedItem="{Binding NewUnit}"
                                                          Background="#1E1E2E" Foreground="Black" Padding="6" Height="34"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                                <TextBlock Text="Cost / Unit (ETB):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding NewCostPerUnit, UpdateSourceTrigger=PropertyChanged}" 
                                                         Background="#1E1E2E" Foreground="White" BorderBrush="{StaticResource BorderColorBrush}" Padding="6"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                                <TextBlock Text="Initial Stock:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding NewInitialStock, UpdateSourceTrigger=PropertyChanged}" 
                                                         Background="#1E1E2E" Foreground="White" BorderBrush="{StaticResource BorderColorBrush}" Padding="6"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                                <TextBlock Text="Low Threshold:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding NewLowStockThreshold, UpdateSourceTrigger=PropertyChanged}" 
                                                         Background="#1E1E2E" Foreground="White" BorderBrush="{StaticResource BorderColorBrush}" Padding="6"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Initial Note / Supplier:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding NewNote, UpdateSourceTrigger=PropertyChanged}" 
                                                 Background="#1E1E2E" Foreground="White" BorderBrush="{StaticResource BorderColorBrush}" Padding="6" Margin="0,0,0,12"/>

                                        <Button Content="➕ REGISTER NEW INGREDIENT" Style="{StaticResource PrimaryButtonStyle}" Height="40"
                                                Command="{Binding AddNewIngredientCommand}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- Tab 2: Audit History Logs -->
                <TabItem Header="📜 Inventory Audit Logs &amp; History">
                    <Grid Margin="0,15,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Button Grid.Row="0" Content="Refresh Logs" Style="{StaticResource PrimaryButtonStyle}" 
                                HorizontalAlignment="Right" Margin="0,0,0,10" Command="{Binding RefreshCommand}"/>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding InventoryLogs}" AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="{StaticResource CardBackgroundBrush}" Foreground="White" RowBackground="#252538" AlternatingRowBackground="#2D2D44"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderColorBrush}" HeadersVisibility="Column" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date &amp; Time" Binding="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="160"/>
                                <DataGridTextColumn Header="Ingredient" Binding="{Binding IngredientName}" Width="180"/>
                                <DataGridTextColumn Header="Change Quantity" Binding="{Binding ChangeAmount, StringFormat='{}{0:+#,##0.00;-#,##0.00;0}'}" Width="130"/>
                                <DataGridTextColumn Header="Reason / Note (Who &amp; Why)" Binding="{Binding Reason}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- Edit Ingredient Overlay Dialog -->
            <Border Background="#1A1A28" CornerRadius="12" Padding="20" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="2"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Width="450"
                    Visibility="{Binding IsEditingIngredient, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <Grid Margin="0,0,0,15">
                        <TextBlock Text="Edit Ingredient Details" Foreground="White" FontSize="18" FontWeight="Bold"/>
                        <Button Content="✕" Style="{StaticResource DangerButtonStyle}" HorizontalAlignment="Right" Width="30" Height="30" Padding="0"
                                Command="{Binding CancelEditIngredientCommand}"/>
                    </Grid>

                    <TextBlock Text="Ingredient Name:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" 
                             Background="#1E1E2E" Foreground="White" BorderBrush="{StaticResource BorderColorBrush}" Padding="8" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Unit Metric:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,2"/>
                            <ComboBox ItemsSource="{Binding UnitsList}" SelectedItem="{Binding EditUnit}"
                                      Background="#1E1E2E" Foreground="Black" Padding="6" Height="36"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="Cost / Unit (ETB):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding EditCostPerUnit, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#1E1E2E" Foreground="White" BorderBrush="{StaticResource BorderColorBrush}" Padding="8" Height="36"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Low-Stock Threshold:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding EditLowStockThreshold, UpdateSourceTrigger=PropertyChanged}" 
                             Background="#1E1E2E" Foreground="White" BorderBrush="{StaticResource BorderColorBrush}" Padding="8" Margin="0,0,0,20"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Cancel" Style="{StaticResource DangerButtonStyle}" Margin="0,0,5,0" Height="40"
                                Command="{Binding CancelEditIngredientCommand}"/>
                        <Button Grid.Column="1" Content="💾 SAVE CHANGES" Style="{StaticResource SuccessButtonStyle}" Margin="5,0,0,0" Height="40"
                                Command="{Binding SaveEditIngredientCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
