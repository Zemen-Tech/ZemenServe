<UserControl x:Class="ZemenServe.Cashier.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Manager Daily Sales &amp; Waiter Performance Report" Foreground="White" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="Calculates revenue from Paid orders, COGS, Net Profit, and Waiter performance leaderboard." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
        </StackPanel>

        <!-- Date Picker & PDF Trigger Header -->
        <Border Grid.Row="1" Background="{StaticResource CardBackgroundBrush}" CornerRadius="10" Padding="15" Margin="0,0,0,20">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Select Date:" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay}" Width="160" Height="34" VerticalAlignment="Center"/>
                    <Button Content="🔄 Refresh Report" Style="{StaticResource PrimaryButtonStyle}" Margin="15,0,0,0"
                            Command="{Binding LoadReportCommand}"/>
                </StackPanel>

                <Button Grid.Column="1" Content="📄 EXPORT DAILY PDF REPORT" Style="{StaticResource SuccessButtonStyle}" 
                        HorizontalAlignment="Right" Height="40" Padding="20,0"
                        Command="{Binding GeneratePdfCommand}"/>
            </Grid>
        </Border>

        <!-- KPI Summary Cards & Details -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Cards -->
            <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,20">
                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="10" Margin="0,0,10,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="TOTAL PAID REVENUE" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text="{Binding CurrentReport.TotalRevenue, StringFormat='{}{0:N2} ETB', FallbackValue='0.00 ETB'}" 
                                   Foreground="{StaticResource AccentGreenBrush}" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="10" Margin="5,0,5,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="TOTAL COGS" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text="{Binding CurrentReport.TotalCogs, StringFormat='{}{0:N2} ETB', FallbackValue='0.00 ETB'}" 
                                   Foreground="{StaticResource AccentOrangeBrush}" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="10" Margin="10,0,0,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="NET PROFIT" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text="{Binding CurrentReport.NetProfit, StringFormat='{}{0:N2} ETB', FallbackValue='0.00 ETB'}" 
                                   Foreground="{StaticResource PrimaryBrush}" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Tables Grid: Items Breakdown & Waiters Sales Leaderboard -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Item Sales Breakdown DataGrid -->
                <Border Grid.Column="0" Background="{StaticResource CardBackgroundBrush}" CornerRadius="10" Padding="15" Margin="0,0,15,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="🍔 Food &amp; Beverage Item Sales Breakdown" Foreground="White" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding CurrentReport.ItemsSold}" AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="#1E1E2E" Foreground="White" RowBackground="#252538" AlternatingRowBackground="#2D2D44"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderColorBrush}" HeadersVisibility="Column" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Item Name" Binding="{Binding ItemName}" Width="*"/>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120"/>
                                <DataGridTextColumn Header="Qty" Binding="{Binding QuantitySold}" Width="60"/>
                                <DataGridTextColumn Header="Revenue (ETB)" Binding="{Binding TotalRevenue, StringFormat='{}{0:N2}'}" Width="110"/>
                                <DataGridTextColumn Header="COGS" Binding="{Binding EstimatedCogs, StringFormat='{}{0:N2}'}" Width="100"/>
                                <DataGridTextColumn Header="Profit" Binding="{Binding GrossProfit, StringFormat='{}{0:N2}'}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Right: Waiter Performance Leaderboard -->
                <Border Grid.Column="1" Background="{StaticResource CardBackgroundBrush}" CornerRadius="10" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="🏆 Waiter Sales Leaderboard (Daily)" Foreground="White" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding CurrentReport.WaiterSales}" AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="#1E1E2E" Foreground="White" RowBackground="#252538" AlternatingRowBackground="#2D2D44"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderColorBrush}" HeadersVisibility="Column" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Rank" Binding="{Binding Badge}" Width="90"/>
                                <DataGridTextColumn Header="Waiter Name" Binding="{Binding WaiterName}" Width="*"/>
                                <DataGridTextColumn Header="Orders" Binding="{Binding TotalOrders}" Width="65"/>
                                <DataGridTextColumn Header="Sales (ETB)" Binding="{Binding TotalRevenue, StringFormat='{}{0:N2}'}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
