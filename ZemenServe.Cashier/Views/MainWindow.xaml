<Window x:Class="ZemenServe.Cashier.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ZemenServe.Cashier.Views"
        xmlns:viewmodels="clr-namespace:ZemenServe.Cashier.ViewModels"
        Title="ZemenServe — Cashier POS &amp; Host Terminal (Zemen Tech)" 
        Height="780" Width="1240"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundDarkBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Margin="0,10,0,25">
                    <TextBlock Text="ZemenServe" Foreground="White" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="POS &amp; F&amp;B Control System" Foreground="{StaticResource PrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    <Border Height="1" Background="{StaticResource BorderColorBrush}" Margin="0,15,0,0"/>
                </StackPanel>

                <!-- Navigation RadioButtons -->
                <StackPanel Grid.Row="1">
                    <RadioButton Content="🛒 Order Entry (POS)" Style="{StaticResource NavButtonStyle}" IsChecked="True"
                                 Command="{Binding NavigateCommand}" CommandParameter="OrderEntry"/>
                    <RadioButton Content="📜 Standalone Digital Menu" Style="{StaticResource NavButtonStyle}"
                                 Command="{Binding NavigateCommand}" CommandParameter="DigitalMenu"/>
                    <RadioButton Content="📦 Inventory &amp; Stock" Style="{StaticResource NavButtonStyle}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Inventory"/>
                    <RadioButton Content="📊 Daily Reports" Style="{StaticResource NavButtonStyle}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Reports"/>
                    <RadioButton Content="👤 Waiters" Style="{StaticResource NavButtonStyle}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Settings"/>
                </StackPanel>

                <!-- Server Host Indicator Footer -->
                <Border Grid.Row="2" Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="{StaticResource AccentGreenBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="SignalR Server Active" Foreground="White" FontSize="12" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="Host: http://0.0.0.0:5000" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="18,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main View Content Area -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentView}">
            <ContentControl.Resources>
                <DataTemplate DataType="{x:Type viewmodels:OrderEntryViewModel}">
                    <views:OrderEntryView/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewmodels:DigitalMenuViewModel}">
                    <views:DigitalMenuView/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewmodels:InventoryViewModel}">
                    <views:InventoryView/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewmodels:ReportsViewModel}">
                    <views:ReportsView/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewmodels:SettingsViewModel}">
                    <views:SettingsView/>
                </DataTemplate>
            </ContentControl.Resources>
        </ContentControl>
    </Grid>
</Window>
