<UserControl x:Class="ZemenServe.Cashier.Views.OrderEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- Left Column: Menu Items Catalog -->
        <Grid Grid.Column="0" Margin="0,0,15,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Category Selector Buttons -->
            <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,15">
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}" 
                                    Margin="0,0,8,0"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding DataContext.LoadDataCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Food Item Cards Grid -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding MenuItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardBackgroundBrush}" 
                                    CornerRadius="10" Margin="6" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="{Binding Category}" 
                                               Foreground="{StaticResource TextSecondaryBrush}" 
                                               FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="1" Text="{Binding Name}" 
                                               Foreground="{StaticResource TextPrimaryBrush}" 
                                               FontSize="16" FontWeight="Bold" Margin="0,4,0,8" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="2" Text="{Binding Price, StringFormat='{}{0:N2} ETB'}" 
                                               Foreground="{StaticResource AccentGreenBrush}" 
                                               FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>

                                    <Button Grid.Row="3" Content="+ Add to Order" 
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Right Column: Current Order Cart -->
        <Border Grid.Column="1" Background="{StaticResource CardBackgroundBrush}" CornerRadius="12" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Current Order Cart" 
                           Foreground="{StaticResource TextPrimaryBrush}" 
                           FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                <!-- Cart Items List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding CartItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding MenuItemName}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding UnitPrice, StringFormat='{}{0:N2} ETB'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                        </StackPanel>

                                        <!-- Quantity Manipulator -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0">
                                            <Button Content="-" Width="28" Height="28" Padding="0" Style="{StaticResource PrimaryButtonStyle}"
                                                    Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <TextBlock Text="{Binding Quantity}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0"/>
                                            <Button Content="+" Width="28" Height="28" Padding="0" Style="{StaticResource PrimaryButtonStyle}"
                                                    Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding TotalPrice, StringFormat='{}{0:N2}'}" 
                                                   Foreground="{StaticResource AccentGreenBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Note Input -->
                <StackPanel Grid.Row="2" Margin="0,15,0,10">
                    <TextBlock Text="Kitchen Note / Instructions:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding CashierNote, UpdateSourceTrigger=PropertyChanged}" 
                             Background="#1E1E2E" Foreground="White" BorderBrush="{StaticResource BorderColorBrush}" Padding="8"/>
                </StackPanel>

                <!-- Total Amount Card -->
                <Border Grid.Row="3" Background="#1E1E2E" CornerRadius="8" Padding="12" Margin="0,0,0,15">
                    <Grid>
                        <TextBlock Text="Total Payable:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CartTotal, StringFormat='{}{0:N2} ETB'}" Foreground="{StaticResource AccentGreenBrush}" 
                                   FontSize="22" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <!-- Checkout Action Button -->
                <Button Grid.Row="4" Content="SUBMIT ORDER TO KITCHEN ➔" 
                        Style="{StaticResource SuccessButtonStyle}" Height="48" FontSize="16"
                        Command="{Binding CheckoutCommand}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
