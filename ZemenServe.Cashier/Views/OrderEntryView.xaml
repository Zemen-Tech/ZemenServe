<UserControl x:Class="ZemenServe.Cashier.Views.OrderEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="440"/>
        </Grid.ColumnDefinitions>

        <!-- Left Column: Digital Menu Catalog & Active Orders Tracker -->
        <Grid Grid.Column="0" Margin="0,0,15,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="240"/>
            </Grid.RowDefinitions>

            <!-- Category Selector Buttons -->
            <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,15">
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}" 
                                     Margin="0,0,8,0"
                                     Style="{StaticResource PrimaryButtonStyle}"
                                     Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Food Item Cards Grid -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
                <ItemsControl ItemsSource="{Binding MenuItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardBackgroundBrush}" 
                                     CornerRadius="10" Margin="6" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="{Binding Category}" 
                                               Foreground="{StaticResource TextSecondaryBrush}" 
                                               FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="1" Text="{Binding Name}" 
                                               Foreground="{StaticResource TextPrimaryBrush}" 
                                               FontSize="16" FontWeight="Bold" Margin="0,4,0,8" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="2" Text="{Binding Price, StringFormat='{}{0:N2} ETB'}" 
                                               Foreground="{StaticResource AccentGreenBrush}" 
                                               FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>

                                    <Button Grid.Row="3" Content="+ Add to Order" 
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Active Open Orders Panel (Bottom Drawer) -->
            <Border Grid.Row="2" Background="{StaticResource CardBackgroundBrush}" CornerRadius="12" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="📋 Active Unpaid Orders (Click to inspect, edit or cancel)" 
                                   Foreground="White" FontSize="14" FontWeight="Bold"/>
                        <Button Content="🔄 Refresh" HorizontalAlignment="Right" Style="{StaticResource PrimaryButtonStyle}" Height="26" Padding="8,0"
                                Command="{Binding LoadDataCommand}"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ActiveOrders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E1E2E" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Id, StringFormat='Order #{0}'}" Foreground="White" FontSize="14" FontWeight="Bold"/>
                                                    <Border Margin="8,0,0,0" CornerRadius="4" Padding="6,2" Background="#35354E">
                                                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource AccentOrangeBrush}" FontSize="11" FontWeight="Bold"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding WaiterName, StringFormat='Waiter: {0}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" Text="{Binding TotalAmount, StringFormat='{}{0:N2} ETB'}" 
                                                       Foreground="{StaticResource AccentGreenBrush}" FontSize="15" FontWeight="Bold" 
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <Button Content="👁️ Details / Edit" Style="{StaticResource PrimaryButtonStyle}" Height="30" Padding="8,0" Margin="0,0,6,0"
                                                        Command="{Binding DataContext.SelectActiveOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>

                                                <Button Content="💳 Mark Paid" Style="{StaticResource SuccessButtonStyle}" Height="30" Padding="8,0" Margin="0,0,6,0"
                                                        Command="{Binding DataContext.MarkPaidCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>

                                                <Button Content="🚫 Cancel" Style="{StaticResource DangerButtonStyle}" Height="30" Padding="8,0"
                                                        Command="{Binding DataContext.CancelActiveOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Right Column: Current Order Cart & Selected Active Order Items Manager -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Active Order Item Details Manager (Shown when SelectedActiveOrder != null) -->
            <Border Grid.Row="0" Visibility="{Binding IsActiveOrderSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Background="#2A1B1B" BorderBrush="{StaticResource AccentOrangeBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SelectedActiveOrder.Id, StringFormat='Order #{0} Details'}" Foreground="White" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="{Binding SelectedActiveOrder.WaiterName, StringFormat=' (Waiter: {0})'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Content="✕ Close" HorizontalAlignment="Right" Style="{StaticResource DangerButtonStyle}" Height="24" Padding="8,0"
                                Command="{Binding ClearSelectedActiveOrderCommand}"/>
                    </Grid>

                    <TextBlock Grid.Row="1" Text="Click '❌ Remove' to delete specific food items from this active order:" 
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8"/>

                    <!-- Items in Active Order -->
                    <ScrollViewer Grid.Row="2" MaxHeight="180" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                        <ItemsControl ItemsSource="{Binding SelectedActiveOrder.Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E1E2E" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding MenuItemName}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat='Qty: {0}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="10,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding TotalPrice, StringFormat='{}{0:N2} ETB'}" Foreground="{StaticResource AccentGreenBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0"/>

                                            <Button Grid.Column="3" Content="❌ Remove" Style="{StaticResource DangerButtonStyle}" Height="26" Padding="8,0"
                                                    Command="{Binding DataContext.RemoveItemFromActiveOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Active Order Summary Actions -->
                    <Grid Grid.Row="3">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Total Amount: " Foreground="White" FontSize="13"/>
                            <TextBlock Text="{Binding SelectedActiveOrder.TotalAmount, StringFormat='{}{0:N2} ETB'}" Foreground="{StaticResource AccentGreenBrush}" FontSize="15" FontWeight="Bold"/>
                        </StackPanel>

                        <Button Content="🚫 Cancel Entire Order" HorizontalAlignment="Right" Style="{StaticResource DangerButtonStyle}" Height="30" Padding="10,0"
                                Command="{Binding CancelActiveOrderCommand}" CommandParameter="{Binding SelectedActiveOrder}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Main Order Entry Cart -->
            <Border Grid.Row="1" Background="{StaticResource CardBackgroundBrush}" CornerRadius="12" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Current Order Cart" 
                               Foreground="{StaticResource TextPrimaryBrush}" 
                               FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                    <!-- Waiter Selection Dropdown -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock Text="Assigned Waiter Name:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Waiters}" SelectedItem="{Binding SelectedWaiter}" DisplayMemberPath="Name"
                                  Height="36" Padding="8,0" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Cart Items List -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CartItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding MenuItemName}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding UnitPrice, StringFormat='{}{0:N2} ETB'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                            </StackPanel>

                                            <!-- Quantity Manipulator -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0">
                                                <Button Content="-" Width="28" Height="28" Padding="0" Style="{StaticResource PrimaryButtonStyle}"
                                                        Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <TextBlock Text="{Binding Quantity}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0"/>
                                                <Button Content="+" Width="28" Height="28" Padding="0" Style="{StaticResource PrimaryButtonStyle}"
                                                        Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{Binding TotalPrice, StringFormat='{}{0:N2}'}" 
                                                       Foreground="{StaticResource AccentGreenBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Note Input -->
                    <StackPanel Grid.Row="3" Margin="0,10,0,10">
                        <TextBlock Text="Kitchen Note / Special Instructions:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding CashierNote, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="#1E1E2E" Foreground="White" BorderBrush="{StaticResource BorderColorBrush}" Padding="8"/>
                    </StackPanel>

                    <!-- Order Total & Actions -->
                    <Grid Grid.Row="4" Margin="0,5,0,15">
                        <TextBlock Text="Subtotal Amount:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CartTotal, StringFormat='{}{0:N2} ETB'}" 
                                   Foreground="{StaticResource AccentGreenBrush}" 
                                   FontSize="22" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>

                    <Button Grid.Row="5" Content="🚀 Send Order to Kitchen" Style="{StaticResource PrimaryButtonStyle}" Height="46" FontSize="15"
                            Command="{Binding CheckoutCommand}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
